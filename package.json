{
  "name": "she-wasm",
  "version": "1.8.0",
  "description": "Two-level homomorphic encryption for Node.js by WebAssembly",
  "main": "src/index.js",
  "packageManager": "pnpm@10.29.1",
  "scripts": {
    "build": "pnpm run build:she_c.js && pnpm run build:browser",
    "build:she_c.js": "cd src && make",
    "build:browser": "cd browser && pnpm install && pnpm webpack",
    "test": "node test/test.js",
    "update-all": "pnpm update && pnpm --dir browser update"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/herumi/she-wasm.git"
  },
  "keywords": [
    "homomorphic encrpytion",
    "WebAssembly",
    "pairing"
  ],
  "files": [
    "package.json",
    "src/index.js",
    "src/she.js",
    "src/she_c.js",
    "browser/she.js",
    "browser/package.json",
    "browser/src/index-browser.js"
  ],
  "author": "herumi <herumi@nifty.com> (https://github.com/herumi/)",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/herumi/she-wasm/issues"
  },
  "homepage": "https://github.com/herumi/she-wasm#readme"
}
